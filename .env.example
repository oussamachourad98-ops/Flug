# Copy to .env (never commit .env). All values can also be set as real environment variables.

# --- Flight data -------------------------------------------------------------
# duffel | serpapi | duffel,serpapi
PROVIDERS=duffel
# Duffel: https://app.duffel.com -> Developers -> Access tokens.
# duffel_test_... = fictional "Duffel Airways" data; duffel_live_... = real airline offers.
DUFFEL_ACCESS_TOKEN=
# Duffel charges $0.005 per search beyond a 1500:1 search-to-booking ratio (0 bookings counts as 1).
DUFFEL_MONTHLY_SEARCH_LIMIT=1500
DUFFEL_MAX_OFFERS_PER_SEARCH=20
# SerpApi (Google Flights): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
SERPAPI_MONTHLY_SEARCH_LIMIT=250
SERPAPI_GL=de
SERPAPI_HL=de

# --- Scheduling --------------------------------------------------------------
SEARCH_INTERVAL_MINUTES=30
RUN_ON_START=true

# --- Telegram ----------------------------------------------------------------
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Re-alert the same itinerary only if it got at least this much cheaper
ALERT_MIN_DROP=1.00

# --- Storage & dashboard -----------------------------------------------------
DATABASE_URL=sqlite:///data/flug.db
# DATABASE_URL=postgresql+psycopg://flug:secret@db:5432/flug
WATCHES_FILE=watches.yaml
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-string
LOG_LEVEL=INFO
